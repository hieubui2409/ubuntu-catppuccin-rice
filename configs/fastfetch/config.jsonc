// Catppuccin Mocha — fastfetch
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "padding": { "top": 1 }, "color": { "1": "magenta", "2": "blue" } },
    "display": {
        "separator": "  ",
        "color": { "keys": "magenta", "title": "magenta" }
    },
    "modules": [
        "title", "separator",
        { "type": "os",      "key": "󰕈  OS",     "keyColor": "magenta" },
        { "type": "kernel",  "key": "  Kernel", "keyColor": "blue" },
        { "type": "uptime",  "key": "󰅐  Uptime", "keyColor": "cyan" },
        { "type": "packages","key": "󰏖  Pkgs",   "keyColor": "green" },
        { "type": "de",      "key": "  DE",     "keyColor": "yellow" },
        { "type": "wm",      "key": "  WM",     "keyColor": "red" },
        { "type": "terminal","key": "  Term",   "keyColor": "magenta" },
        { "type": "cpu",     "key": "󰻠  CPU",    "keyColor": "blue" },
        { "type": "gpu",     "key": "󰢮  GPU",    "keyColor": "cyan" },
        { "type": "memory",  "key": "󰾆  RAM",    "keyColor": "green" },
        "break", "colors"
    ]
}
